{
	"name": "hausfrieden",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply hausfrieden --local",
		"db:migrate:remote": "wrangler d1 migrations apply hausfrieden --remote",
		"cf-typegen": "wrangler types",
		"cap:ios": "npm run cap:sync && cap open ios",
		"cap:android": "npm run cap:sync && cap open android",
		"cap:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#1F8A8A\" --splashBackgroundColor \"#FBF6EE\"",
		"build:native": "vite build --mode native",
		"cap:sync": "npm run build:native && cap sync"
	},
	"devDependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/assets": "^4.0.0",
		"@capacitor/cli": "^8.6.0",
		"@capacitor/ios": "^8.6.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.156.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.6.0",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"better-auth": "^1.7.14",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	}
}
